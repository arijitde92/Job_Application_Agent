# ──────────────────────────────────────────────────────────────────────────
# Frontend environment — copy to `frontend/.env` and fill in real values.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ──────────────────────────────────────────────────────────────────────────

# Base URL for the backend API. In dev, Vite proxies /api → http://localhost:8000
# (see vite.config.js), so this can stay as the relative default.
VITE_API_BASE_URL=/api

# Google OAuth client ID (for "Sign in with Google")
VITE_GOOGLE_OAUTH_CLIENT_ID=
