# ──────────────────────────────────────────────────────────────────────────
# Backend environment — copy to `backend/.env` and fill in real values.
# The app reads this file (BaseSettings, model_config env_file=".env") when
# started from the `backend/` directory.
# ──────────────────────────────────────────────────────────────────────────

# ── GCP ────────────────────────────────────────────────────────────────────
# Absolute path to the downloaded service-account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GCP_PROJECT_ID=
GCP_LOCATION=asia-south2

# ── Weaviate (GitHub repo vector store) ────────────────────────────────────
# Cluster URL from the Weaviate Cloud console; the scheme is optional.
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION_NAME=GithubRepoData

# ── Voyage AI (embeddings + reranking) ─────────────────────────────────────
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-code-3
VOYAGE_EMBED_DIMENSION=1024
VOYAGE_RERANK_MODEL=rerank-2.5-lite

# ── API keys ───────────────────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=
SERPER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BRIGHT_DATA_API_KEY=
# Z.ai (GLM-5.2, used by the GitHub project summarizer agent)
ZAI_API_KEY=
# Optional — leave blank for https://api.z.ai/api/paas/v4
ZAI_BASE_URL=

# ── Resume DOCX generation service ─────────────────────────────────────────
# External service the Resume Strategist calls to render the tailored resume
# as a .docx. Leave the default unless you host your own instance.
RESUME_DOCX_SERVICE_URL=http://resume-service-alb-1115872566.us-east-2.elb.amazonaws.com/api/v1/resume/generate
RESUME_DOCX_TIMEOUT_SECONDS=120

# ── Logging ────────────────────────────────────────────────────────────────
# Console log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Cloud SQL (MySQL) ──────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=job_applier

# ── GCS bucket for resumes ─────────────────────────────────────────────────
GCS_BUCKET_NAME=

# ── JWT authentication ─────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── Google OAuth (optional) ────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── CrewAI ─────────────────────────────────────────────────────────────────
CREWAI_TOOLS_ALLOW_UNSAFE_PATHS=true
CREWAI_TRACING_ENABLED=true

# ── CORS (comma-separated frontend origins) ────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Resume upload limit ────────────────────────────────────────────────────
MAX_RESUME_SIZE_MB=10
