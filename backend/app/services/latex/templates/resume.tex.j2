((= Jinja2 template of the tailored resume (derived from apex_resume.tex).
    The delimiters are LaTeX-safe double-parenthesis forms - see renderer.py.
    Every interpolated value is escaped by the renderer's filters
    (tex / texurl / urldisplay) - never interpolate raw text. =))
\documentclass[letterpaper,11pt]{article}

\usepackage{iftex}
\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{fontawesome5}
\usepackage{multicol}
\usepackage{ragged2e}
\setlength{\multicolsep}{-3.0pt}
\setlength{\columnsep}{-1pt}

% Ensure that the generated PDF is machine readable/ATS parsable. XeTeX
% (Tectonic) writes Unicode text natively and has no \pdfgentounicode.
\ifPDFTeX
  \input{glyphtounicode}
  \pdfgentounicode=1
\fi

\RequirePackage{xcolor}

\definecolor{cvblue}{HTML}{0E5484}
\definecolor{black}{HTML}{130810}
\definecolor{darkcolor}{HTML}{0F4539}
\definecolor{cvgreen}{HTML}{3BD80D}
\definecolor{taggreen}{HTML}{00E278}
\definecolor{SlateGrey}{HTML}{2E2E2E}
\definecolor{LightGrey}{HTML}{666666}
\colorlet{name}{black}
\colorlet{tagline}{darkcolor}
\colorlet{heading}{darkcolor}
\colorlet{headingrule}{cvblue}
\colorlet{subheading}{SlateGrey}
\colorlet{accent}{darkcolor}
\colorlet{emphasis}{SlateGrey}
\colorlet{body}{LightGrey}

\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.6in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1.19in}
\addtolength{\topmargin}{-.7in}
\addtolength{\textheight}{1.4in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large\bfseries
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{1.0\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{\large#1} & \textbf{\small #2} \\
      \textit{\large#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{1.001\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & \textbf{\small #2}\\
    \end{tabular*}\vspace{-7pt}
}

\renewcommand\labelitemi{$\vcenter{\hbox{\tiny$\bullet$}}$}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.0in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{document}

%----------HEADING----------
\begin{center}
    {\Huge \scshape ((( r.personal_information.name|tex )))} \\ \vspace{4pt}
((* if r.personal_information.location *))
    {\small ((( r.personal_information.location|tex )))} \\ \vspace{4pt}
((* endif *))
((* if contacts *))

    \small
    ((( contacts|join(" ~ $|$ ~\n    ") )))
((* endif *))

    \vspace{-8pt}
\end{center}
((= Sections render in layout.sections order (see app/services/latex/layout.py): the standard order, or the early-career order when total work experience is under one year. Only non-empty sections are listed. =))
((* for section in layout.sections *))
((* if section == "summary" *))
%-----------SUMMARY-----------
\section{Professional Summary}
\begin{justify}
\small{((( r.summary|tex )))}
\end{justify}
\vspace{-10pt}
((* elif section == "experience" *))

%-----------EXPERIENCE-----------
\section{Work Experience}
\resumeSubHeadingListStart
((* for e in layout.experience *))

    \resumeSubheading
      {((( e.company|tex )))((* if e.location *)), ((( e.location|tex )))((* endif *))}{((( daterange(e.start_date, e.end_date) )))}
      {((( e.job_title|tex )))}{((( e.work_mode|tex )))}
((* if e.bullets *))
      \resumeItemListStart
((* for b in e.bullets *))
        \resumeItem{((( b|tex )))}
((* endfor *))
      \resumeItemListEnd
((* endif *))
((* endfor *))

\resumeSubHeadingListEnd
\vspace{-16pt}
((* elif section == "education" *))

%-----------EDUCATION-----------
\section{Education}
\resumeSubHeadingListStart
((* for ed in r.education *))

    \resumeSubheading
      {((( ed.institution|tex )))((* if ed.location *)), ((( ed.location|tex )))((* endif *))}{((( daterange(ed.start_date, ed.end_date) )))}
      {((( ed.degree|tex )))((* if ed.gpa *)) \textbar{} GPA: ((( ed.gpa|tex )))((* endif *))}{}
((* endfor *))

\resumeSubHeadingListEnd
\vspace{-16pt}
((* elif section == "skills" *))

%-----------TECHNICAL SKILLS-----------
\section{Skills}
\begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
((* for s in r.skills *))
        \textbf{((( s.category|tex )))}{: ((( s.skills|map("tex")|join(", ") )))}((* if not loop.last *)) \\((* endif *))

((* endfor *))
    }}
\end{itemize}
\vspace{-16pt}
((* elif section == "projects" *))

%-----------PROJECTS-----------
\section{Projects}
\resumeSubHeadingListStart
((* for p in r.projects *))

    \resumeProjectHeading
          {\textbf{((( p.name|tex )))}}{((* if p.url *))\href{((( p.url|texurl )))}{\underline{((( p.url|urldisplay )))}}((* endif *))}
((* if p.bullets *))
          \resumeItemListStart
((* for b in p.bullets *))
        \resumeItem{((( b|tex )))}
((* endfor *))
          \resumeItemListEnd((* if not loop.last *))\vspace{-8pt}((* endif *))

((* endif *))
((* endfor *))

\resumeSubHeadingListEnd
\vspace{-16pt}
((* elif section == "publications" *))

%-----------PUBLICATIONS-----------
\section{Publications}
\begin{itemize}[itemsep=0pt, parsep=0pt, topsep=2pt]
((* for pub in r.publications *))
    \item\small{((( pub.citation|tex )))}
((* endfor *))
\end{itemize}
\vspace{-8pt}
((* elif section == "certifications" *))

%-----------CERTIFICATIONS-----------
\section{Certifications}
\begin{itemize}[itemsep=0pt, parsep=0pt, topsep=2pt]
((* for c in r.certifications *))
    \item\small{((( certification(c) )))}
((* endfor *))
\end{itemize}
((* if not loop.last *))
\vspace{-8pt}
((* endif *))
((* endif *))
((* endfor *))

\end{document}
